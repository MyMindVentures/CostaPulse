{
  "name": "costapulse",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && node scripts/prepare-standalone.cjs",
    "start": "node start-standalone.cjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run smoke:production",
    "production:check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run smoke:production",
    "precommit:check": "node scripts/quality/check-secrets.mjs && npx lint-staged && npm run guardrails",
    "prepush:check": "npm run production:check",
    "smoke:production": "node scripts/quality/smoke-production.mjs",
    "guardrails": "node scripts/quality/run-guardrails.mjs",
    "commitlint": "commitlint --edit",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-label": "^2.1.14",
    "@radix-ui/react-separator": "^1.1.14",
    "@radix-ui/react-slot": "1.2.4",
    "@react-email/render": "^1.1.2",
    "@sentry/nextjs": "10.68.0",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.57.4",
    "@swc/helpers": "^0.5.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "0.468.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.11",
    "next-intl": "4.13.4",
    "pdfjs-dist": "^6.2.108",
    "posthog-js": "1.280.1",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.0",
    "react-hook-form": "7.65.0",
    "resend": "6.1.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "stripe": "19.1.0",
    "tailwind-merge": "3.3.1",
    "vaul": "^1.1.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/nextjs-vite": "^9.1.20",
    "@tailwindcss/postcss": "4.1.14",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "^4.0.8",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.11",
    "husky": "^9.1.7",
    "jsdom": "27.1.0",
    "lint-staged": "^16.4.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.1",
    "storybook": "^9.1.20",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  }
}
